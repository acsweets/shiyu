<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">
        <FrameLayout
            android:id="@+id/widget_card_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="46dp">

            <LinearLayout
                android:id="@+id/widget_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:background="@drawable/retirement_widget_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/widget_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/widget_refresh_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/widget_refresh_symbol"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_heading"
                    android:textColor="#45363B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/widget_value"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:autoSizeMaxTextSize="24sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_setup"
                    android:textColor="#45363B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/widget_extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_cat_sticker"
            android:layout_width="58dp"
            android:layout_height="50dp"
            android:layout_gravity="top|center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cat" />

        <ImageView
            android:id="@+id/widget_cat_compact"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cat"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
